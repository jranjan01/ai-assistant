# This is an example .env file for the AI Assistant project.

# Ollama's OpenAI-compatible endpoint
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Ollama does not need a key, but the OpenAI client requires some value
OPENAI_API_KEY=dummy_api_key

# The model to use for the AI assistant. You can change this to any other model supported by Ollama.
MODEL=qwen3:4b

# The model to use for generating embeddings. You can change this to any other embedding model supported by Ollama.
EMBEDDING_MODEL=nomic-embed-text

# Set to True to enable debug logging, which can help with troubleshooting.
DEBUG=False

# Path to the JSON file used to persist the vector store.
VECTOR_STORE_FILE=knowledge_base/vector_store.json

# Folder containing the knowledge base documents.
KB_FOLDER=knowledge_base